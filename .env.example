# ==========================================
# TaskMaster Monorepo Environment Variables
# ==========================================

# -----------------
# API CONFIGURATION
# -----------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Security Secrets (Must be min 32 chars in production)
JWT_ACCESS_SECRET=super-secret-access-token-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-token-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_SECRET=super-secret-cookie-salt-min-16-chars

# Database (MongoDB with replica set)
MONGODB_URI=mongodb://localhost:27017/taskmaster?replicaSet=rs0&directConnection=true

# Redis (Cache, Rate Limiting, BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Email (SMTP / MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TaskMaster <noreply@taskmaster.local>

# Storage (AWS S3 or Cloudflare R2)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=taskmaster-attachments
AWS_S3_ENDPOINT=

# Logging
LOG_LEVEL=debug

# -----------------
# WEB CONFIGURATION
# -----------------
NEXT_PUBLIC_APP_NAME=TaskMaster
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:5000
